# Copy this file to `.env` and adjust the values.
# Real environment variables always override the file.

# Port the server listens on
PORT=3000

# Interface to bind (0.0.0.0 = all interfaces, 127.0.0.1 = local only)
HOST=0.0.0.0

# Private admin URL. CHANGE THIS to your own hard-to-guess path.
ADMIN_PATH=/sd-panel-x7k29f

# Set to 1 when the site is served over HTTPS so the session cookie
# receives the Secure flag.
# COOKIE_SECURE=1
